MERGE gold.dim_location AS tgt
USING (
    SELECT DISTINCT city, state, postal_code, region, country
    FROM silver.superstore
    WHERE city IS NOT NULL AND state IS NOT NULL AND postal_code IS NOT NULL
) AS src
    ON tgt.city = src.city AND tgt.state = src.state AND tgt.postal_code = src.postal_code
       AND tgt.region = src.region AND tgt.country = src.country
WHEN NOT MATCHED THEN
    INSERT (city, state, postal_code, region, country)
    VALUES (src.city, src.state, src.postal_code, src.region, src.country);
