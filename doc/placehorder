-- ================================================================
-- 4) GOLD LAYER
-- Star schema. First layer with real PK/FK constraints. Every
-- dimension has a -1 "Unknown" member; orphan fact rows point there
-- instead of being dropped. Rows silver flagged as missing/invalid
-- are excluded from gold so report numbers stay clean.
-- ================================================================

-- DIM_DATE
IF OBJECT_ID('gold.dim_date', 'U') IS NULL
BEGIN
    CREATE TABLE gold.dim_date (
        date_key      INT NOT NULL,
        full_date     DATE NOT NULL,
        day           SMALLINT NOT NULL,
        month         SMALLINT NOT NULL,
        month_name    NVARCHAR(20) NOT NULL,
        quarter       SMALLINT NOT NULL,
        year          SMALLINT NOT NULL,
        day_of_week   SMALLINT NOT NULL,
        day_name      NVARCHAR(20) NOT NULL,
        is_weekend    BIT NOT NULL,
        CONSTRAINT PK_gold_dim_date PRIMARY KEY (date_key)
    );
    INSERT INTO gold.dim_date VALUES (-1, '1900-01-01', 1, 1, 'Unknown', 1, 1900, 1, 'Unknown', 0);
END;
GO

MERGE gold.dim_date AS tgt
USING (
    SELECT DISTINCT d AS full_date
    FROM (
        SELECT order_date AS d FROM silver.superstore WHERE order_date IS NOT NULL
        UNION
        SELECT ship_date  AS d FROM silver.superstore WHERE ship_date IS NOT NULL
    ) all_dates
) AS src
    ON tgt.full_date = src.full_date AND tgt.date_key <> -1
WHEN NOT MATCHED THEN
    INSERT (date_key, full_date, day, month, month_name, quarter, year, day_of_week, day_name, is_weekend)
    VALUES (
        CONVERT(INT, FORMAT(src.full_date, 'yyyyMMdd')), src.full_date,
        DATEPART(DAY, src.full_date), DATEPART(MONTH, src.full_date), DATENAME(MONTH, src.full_date),
        DATEPART(QUARTER, src.full_date), DATEPART(YEAR, src.full_date),
        DATEPART(WEEKDAY, src.full_date), DATENAME(WEEKDAY, src.full_date),
        CASE WHEN DATENAME(WEEKDAY, src.full_date) IN ('Saturday','Sunday') THEN 1 ELSE 0 END
    );
GO

-- DIM_CUSTOMER
IF OBJECT_ID('gold.dim_customer', 'U') IS NULL
BEGIN
    CREATE TABLE gold.dim_customer (
        customer_key   INT IDENTITY(1,1) NOT NULL,
        customer_id    NVARCHAR(20) NOT NULL,
        customer_name  NVARCHAR(100) NOT NULL,
        segment        NVARCHAR(30) NOT NULL,
        CONSTRAINT PK_gold_dim_customer PRIMARY KEY (customer_key),
        CONSTRAINT UQ_gold_dim_customer_bk UNIQUE (customer_id)
    );
    SET IDENTITY_INSERT gold.dim_customer ON;
    INSERT INTO gold.dim_customer (customer_key, customer_id, customer_name, segment)
    VALUES (-1, 'UNKNOWN', 'Unknown', 'Unknown');
    SET IDENTITY_INSERT gold.dim_customer OFF;
END;
GO

MERGE gold.dim_customer AS tgt
USING (
    SELECT DISTINCT customer_id, customer_name, segment
    FROM silver.superstore WHERE customer_id IS NOT NULL
) AS src
    ON tgt.customer_id = src.customer_id
WHEN MATCHED THEN
    UPDATE SET tgt.customer_name = src.customer_name, tgt.segment = src.segment
WHEN NOT MATCHED THEN
    INSERT (customer_id, customer_name, segment) VALUES (src.customer_id, src.customer_name, src.segment);
GO

-- DIM_PRODUCT
IF OBJECT_ID('gold.dim_product', 'U') IS NULL
BEGIN
    CREATE TABLE gold.dim_product (
        product_key    INT IDENTITY(1,1) NOT NULL,
        product_id     NVARCHAR(30) NOT NULL,
        product_name   NVARCHAR(200) NOT NULL,
        category       NVARCHAR(50) NOT NULL,
        sub_category   NVARCHAR(50) NOT NULL,
        CONSTRAINT PK_gold_dim_product PRIMARY KEY (product_key),
        CONSTRAINT UQ_gold_dim_product_bk UNIQUE (product_id, product_name)
    );
    SET IDENTITY_INSERT gold.dim_product ON;
    INSERT INTO gold.dim_product (product_key, product_id, product_name, category, sub_category)
    VALUES (-1, 'UNKNOWN', 'Unknown', 'Unknown', 'Unknown');
    SET IDENTITY_INSERT gold.dim_product OFF;
END;
GO

MERGE gold.dim_product AS tgt
USING (
    SELECT DISTINCT product_id, product_name, category, sub_category
    FROM silver.superstore WHERE product_id IS NOT NULL AND product_name IS NOT NULL
) AS src
    ON tgt.product_id = src.product_id AND tgt.product_name = src.product_name
WHEN MATCHED THEN
    UPDATE SET tgt.category = src.category, tgt.sub_category = src.sub_category
WHEN NOT MATCHED THEN
    INSERT (product_id, product_name, category, sub_category)
    VALUES (src.product_id, src.product_name, src.category, src.sub_category);
