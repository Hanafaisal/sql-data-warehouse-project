-- DIM_LOCATION
IF OBJECT_ID('gold.dim_location', 'U') IS NULL
BEGIN
    CREATE TABLE gold.dim_location (
        location_key   INT IDENTITY(1,1) NOT NULL,
        city           NVARCHAR(100) NOT NULL,
        state          NVARCHAR(100) NOT NULL,
        postal_code    INT NOT NULL,
        region         NVARCHAR(30) NOT NULL,
        country        NVARCHAR(50) NOT NULL,
        CONSTRAINT PK_gold_dim_location PRIMARY KEY (location_key),
        CONSTRAINT UQ_gold_dim_location_bk UNIQUE (city, state, postal_code, region, country)
    );
    SET IDENTITY_INSERT gold.dim_location ON;
    INSERT INTO gold.dim_location (location_key, city, state, postal_code, region, country)
    VALUES (-1, 'Unknown', 'Unknown', -1, 'Unknown', 'Unknown');
    SET IDENTITY_INSERT gold.dim_location OFF;
