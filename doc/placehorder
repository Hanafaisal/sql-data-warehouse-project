-- DIM_SHIP_MODE
IF OBJECT_ID('gold.dim_ship_mode', 'U') IS NULL
BEGIN
    CREATE TABLE gold.dim_ship_mode (
        ship_mode_key  INT IDENTITY(1,1) NOT NULL,
        ship_mode      NVARCHAR(30) NOT NULL,
        CONSTRAINT PK_gold_dim_ship_mode PRIMARY KEY (ship_mode_key),
        CONSTRAINT UQ_gold_dim_ship_mode_bk UNIQUE (ship_mode)
    );
    SET IDENTITY_INSERT gold.dim_ship_mode ON;
    INSERT INTO gold.dim_ship_mode (ship_mode_key, ship_mode) VALUES (-1, 'Unknown');
    SET IDENTITY_INSERT gold.dim_ship_mode OFF;
