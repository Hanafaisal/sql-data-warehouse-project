MERGE gold.dim_ship_mode AS tgt
USING (SELECT DISTINCT ship_mode FROM silver.superstore WHERE ship_mode IS NOT NULL) AS src
    ON tgt.ship_mode = src.ship_mode
WHEN NOT MATCHED THEN
    INSERT (ship_mode) VALUES (src.ship_mode);
GO

-- FACT_SALES
IF OBJECT_ID('gold.fact_sales', 'U') IS NULL
BEGIN
    CREATE TABLE gold.fact_sales (
        sales_key       NVARCHAR(20) NOT NULL,
        order_id        NVARCHAR(20) NOT NULL,
        order_date_key  INT NOT NULL,
        ship_date_key   INT NOT NULL,
        customer_key    INT NOT NULL,
        product_key     INT NOT NULL,
        location_key    INT NOT NULL,
        ship_mode_key   INT NOT NULL,
        sales_amount    DECIMAL(12,4) NOT NULL,
        quantity        INT NOT NULL,
        discount        DECIMAL(5,2) NOT NULL,
        profit          DECIMAL(12,4) NOT NULL,
        CONSTRAINT PK_gold_fact_sales PRIMARY KEY (sales_key),
        CONSTRAINT FK_fact_sales_order_date FOREIGN KEY (order_date_key) REFERENCES gold.dim_date(date_key),
        CONSTRAINT FK_fact_sales_ship_date  FOREIGN KEY (ship_date_key)  REFERENCES gold.dim_date(date_key),
        CONSTRAINT FK_fact_sales_customer   FOREIGN KEY (customer_key)   REFERENCES gold.dim_customer(customer_key),
        CONSTRAINT FK_fact_sales_product    FOREIGN KEY (product_key)    REFERENCES gold.dim_product(product_key),
        CONSTRAINT FK_fact_sales_location   FOREIGN KEY (location_key)   REFERENCES gold.dim_location(location_key),
        CONSTRAINT FK_fact_sales_ship_mode  FOREIGN KEY (ship_mode_key)  REFERENCES gold.dim_ship_mode(ship_mode_key)
    );
END;
GO

MERGE gold.fact_sales AS tgt
USING (
    SELECT
        s.row_id                                                    AS sales_key,
        s.order_id                                                  AS order_id,
        ISNULL(CONVERT(INT, FORMAT(s.order_date, 'yyyyMMdd')), -1)  AS order_date_key,
        ISNULL(CONVERT(INT, FORMAT(s.ship_date, 'yyyyMMdd')), -1)   AS ship_date_key,
        ISNULL(c.customer_key, -1)                                  AS customer_key,
        ISNULL(p.product_key, -1)                                   AS product_key,
        ISNULL(l.location_key, -1)                                  AS location_key,
        ISNULL(sm.ship_mode_key, -1)                                AS ship_mode_key,
        s.sales                                                     AS sales_amount,
        s.quantity                                                  AS quantity,
        s.discount                                                  AS discount,
        s.profit                                                    AS profit
    FROM silver.superstore s
    LEFT JOIN gold.dim_customer c   ON s.customer_id = c.customer_id
    LEFT JOIN gold.dim_product p    ON s.product_id = p.product_id AND s.product_name = p.product_name
    LEFT JOIN gold.dim_location l   ON s.city = l.city AND s.state = l.state AND s.postal_code = l.postal_code
    LEFT JOIN gold.dim_ship_mode sm ON s.ship_mode = sm.ship_mode
    WHERE s.has_missing_value = 0 AND s.has_invalid_value = 0
) AS src
    ON tgt.sales_key = src.sales_key
WHEN MATCHED THEN
    UPDATE SET
        tgt.order_id = src.order_id, tgt.order_date_key = src.order_date_key,
        tgt.ship_date_key = src.ship_date_key, tgt.customer_key = src.customer_key,
        tgt.product_key = src.product_key, tgt.location_key = src.location_key,
        tgt.ship_mode_key = src.ship_mode_key, tgt.sales_amount = src.sales_amount,
        tgt.quantity = src.quantity, tgt.discount = src.discount, tgt.profit = src.profit
WHEN NOT MATCHED THEN
    INSERT (sales_key, order_id, order_date_key, ship_date_key, customer_key, product_key,
            location_key, ship_mode_key, sales_amount, quantity, discount, profit)
    VALUES (src.sales_key, src.order_id, src.order_date_key, src.ship_date_key, src.customer_key,
            src.product_key, src.location_key, src.ship_mode_key, src.sales_amount, src.quantity,
            src.discount, src.profit);
GO








